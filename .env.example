# Where the dashboard reads the books from. Defaults to a local api-vista, so
# nothing is needed for local work. Production sets https://api.vistahub.my in
# the Vercel project's environment variables.
VITE_API_BASE_URL=http://127.0.0.1:3000

# Set to 1 to run on the generated demo history with no server at all.
# Never set in production.
# VITE_DEMO=1
